{
  "name": "substack-cli-gemini",
  "version": "0.1.0",
  "description": "Gemini integration docs for the Substack CLI MCP server",
  "private": true,
  "mcpServers": {
    "substack-cli": {
      "command": "npx",
      "args": [
        "-y",
        "@edithatogo/substack-publisher",
        "mcp",
        "serve"
      ],
      "env": {
        "SUBSTACK_PUBLICATION_URL": "https://your-publication.substack.com"
      }
    }
  }
}
