{
  "name": "substack-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "substack-cli": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build -- --watch",
    "inspect": "npm run build && node dist/cli.js inspect",
    "test": "npm run build && node dist/test/run-tests.js",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@browserbasehq/stagehand": "^3.0.0",
    "@tiptap/core": "^3.0.0",
    "@tiptap/html": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "chrome-launcher": "^1.2.1",
    "commander": "^14.0.0",
    "dotenv": "^17.0.0",
    "marked": "^16.0.0",
    "playwright-core": "^1.56.0",
    "zod": "^4.0.0"
  },
  "optionalDependencies": {
    "camoufox-js": "^0.7.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0"
  }
}
