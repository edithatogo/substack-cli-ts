{
  "name": "@edithatogo/substack-publisher",
  "version": "0.2.0",
  "mcpName": "io.github.edithatogo/substack-publisher",
  "description": "Local-first TypeScript CLI and MCP server for publishing Markdown to a user-owned Substack publication.",
  "private": false,
  "license": "Apache-2.0",
  "homepage": "https://github.com/edithatogo/substack-cli-ts#readme",
  "bugs": {
    "url": "https://github.com/edithatogo/substack-cli-ts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edithatogo/substack-cli-ts.git"
  },
  "keywords": [
    "substack",
    "markdown",
    "cli",
    "mcp",
    "model-context-protocol",
    "publishing",
    "newsletter"
  ],
  "type": "module",
  "main": "dist/cli.js",
  "engines": {
    "node": "v26.8.1"
  },
  "bin": {
    "substack-publisher": "dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "registry.server.json",
    "docs/api/",
    "docs/integrations/",
    "docs/examples/mcp-integration.md",
    "extensions/",
    "vendor/substack-api/dist/",
    "vendor/substack-api/package.json",
    "vendor/substack-api/README.md",
    "vendor/substack-api/LICENSE",
    "scripts/install-completions.sh",
    "scripts/install-completions.ps1"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --incremental",
    "dev": "npm run build -- --watch",
    "inspect": "npm run build && node dist/cli.js inspect",
    "test": "npm run build && vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:regression": "vitest run src/test/assurance/regression.test.ts",
    "test:integration": "vitest run src/test/assurance/integration.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && vitest run --config vitest.e2e.config.ts",
    "test:live-canary": "node scripts/substack-live-canary.mjs",
    "test:live-canary:unit": "node --test scripts/substack-live-canary.test.mjs scripts/notify-canary-failure.test.mjs",
    "test:disposable-canary": "node scripts/disposable-publication-canary.mjs",
    "test:disposable-canary:unit": "node --test scripts/disposable-publication-canary.test.mjs",
    "canary:notify": "node scripts/notify-canary-failure.mjs",
    "auth:refresh-state": "npm run build && node dist/cli.js auth refresh-state",
    "test:smoke": "npm run build && vitest run src/test/smoke.test.ts",
    "test:edge": "vitest run src/test/assurance/edge.test.ts",
    "test:mutation": "stryker run",
    "test:property": "vitest run src/test/assurance/property.test.ts",
    "test:dst": "vitest run src/test/assurance/simulation.dst.test.ts",
    "test:cdc": "vitest run src/test/assurance/contract.cdc.test.ts",
    "test:metamorphic": "vitest run src/test/assurance/metamorphic.test.ts",
    "test:agentic": "npm run build && vitest run src/test/assurance/agentic.test.ts",
    "test:semantic-judge": "vitest run src/test/assurance/semantic-judge.test.ts",
    "test:vcr": "vitest run src/test/assurance/network.vcr.test.ts",
    "test:cli-integration": "npm run build && vitest run src/test/assurance/cli.integration.test.ts",
    "test:schema-fuzz": "vitest run src/test/assurance/schema-zod.fuzz.test.ts",
    "test:fuzz": "vitest run src/test/assurance/parser.fuzz.test.ts src/test/assurance/schema-zod.fuzz.test.ts src/test/assurance/property.test.ts",
    "test:contract": "vitest run src/schema/fixtures.test.ts src/test/assurance/contract.cdc.test.ts",
    "verify:agent": "npm run typecheck && npm test && node dist/cli.js inspect examples/basic.md",
    "profile:parser": "npm run build && node --cpu-prof --cpu-prof-dir=reports/profiling dist/cli.js inspect examples/basic.md",
    "test:taxonomy": "node scripts/validate-testing-taxonomy.mjs",
    "test:assurance": "npm run test:taxonomy && npm run build && vitest run src/test/assurance src/test/smoke.test.ts && vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:strictest": "tsc -p tsconfig.strictest.json --pretty false",
    "typecheck:index-signatures": "tsc -p tsconfig.index-signature-strict.json --pretty false",
    "typecheck:dependency-types": "tsc -p tsconfig.dependency-strict.json --pretty false",
    "lint": "biome lint --diagnostic-level=error .",
    "lint:fix": "biome lint --write --unsafe .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check --write .",
    "ci": "biome ci .",
    "scan:secrets": "node scripts/secret-scan.mjs",
    "contracts:generate": "npm run build && node scripts/contracts.mjs generate",
    "contracts:check": "npm run build && node scripts/contracts.mjs check",
    "quality": "npm run test:taxonomy && npm run ci && npm run knip && npm run typecheck && npm run build && npm run test:coverage && npm run test:assurance && npm run test:mutation && npm run scan:secrets && npm run audit:prod",
    "audit:prod": "npm audit --omit=dev",
    "audit:signatures": "npm audit signatures",
    "licenses:check": "node scripts/validate-licenses.mjs",
    "sbom": "node scripts/package-sbom.mjs && node scripts/validate-sbom.mjs",
    "knip": "knip",
    "completions": "node dist/cli.js completion bash > scripts/completions.bash && node dist/cli.js completion zsh > scripts/completions.zsh && node dist/cli.js completion powershell > scripts/completions.ps1",
    "bench": "npm run build && node scripts/performance-suite.mjs",
    "bench:check": "npm run build && node scripts/performance-suite.mjs",
    "bench:test": "node --test scripts/performance-suite.test.mjs",
    "bench:parse": "node dist/cli.js inspect examples/basic.md",
    "profile": "npm run build && node scripts/performance-suite.mjs --profile",
    "profile:cpu": "node --cpu-prof --cpu-prof-dir=reports/profiling dist/cli.js inspect examples/basic.md",
    "profile:heap": "node --heap-prof --heap-prof-dir=reports/profiling dist/cli.js inspect examples/basic.md",
    "prepublishOnly": "npm run quality",
    "registry:summary": "npm run build && node scripts/registry-summary.mjs",
    "registry:publish-command": "npm run build && node scripts/registry-summary.mjs --publish-command",
    "registry:validate": "node scripts/validate-registry-metadata.mjs",
    "registry:publisher": "node scripts/mcp-publisher-helper.mjs",
    "registry:publisher:dry-run": "node scripts/mcp-publisher-helper.mjs dry-run",
    "integrations:validate": "node scripts/validate-client-integrations.mjs",
    "governance:github-programme": "node scripts/github-programme.mjs check",
    "frontier:drift": "npm run build && node scripts/frontier-coverage-drift.mjs",
    "version:check": "node scripts/version-check.mjs check",
    "version:sync": "node scripts/version-check.mjs sync",
    "version:release": "node scripts/version-check.mjs release",
    "release:prepare": "node scripts/release-artifact.mjs prepare",
    "release:rollback:dry-run": "node scripts/release-rollback.mjs",
    "ci:policy": "node --test scripts/ci-contract-policy.test.mjs && node scripts/ci-contract-policy.mjs",
    "verify": "npm run contracts:check && npm run ci:policy && npm run quality && npm run audit:signatures && npm run licenses:check && npm run sbom && npm run registry:validate && npm run integrations:validate && npm pack --dry-run && node scripts/verification-receipt.mjs"
  },
  "dependencies": {
    "@browserbasehq/stagehand": "4.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@opentelemetry/api": "1.9.1",
    "@tiptap/core": "3.30.4",
    "@tiptap/extension-table": "3.27.1",
    "@tiptap/extension-table-cell": "3.27.1",
    "@tiptap/extension-table-header": "3.27.1",
    "@tiptap/extension-table-row": "3.27.1",
    "@tiptap/html": "3.27.1",
    "@tiptap/starter-kit": "3.27.1",
    "axios": "1.19.0",
    "axios-rate-limit": "1.9.0",
    "chrome-launcher": "1.2.1",
    "commander": "15.0.0",
    "dotenv": "17.4.2",
    "fp-ts": "2.16.11",
    "happy-dom": "20.11.2",
    "io-ts": "2.2.22",
    "js-yaml": "5.2.3",
    "marked": "18.0.5",
    "pino": "10.3.1",
    "playwright-core": "1.61.1",
    "zod": "4.4.3"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "js-yaml@<5": "3.15.1",
    "@tiptap/core": "3.30.4",
    "@tiptap/extension-blockquote": "3.24.0",
    "@tiptap/extension-bold": "3.24.0",
    "@tiptap/extension-bullet-list": "3.24.0",
    "@tiptap/extension-code": "3.24.0",
    "@tiptap/extension-code-block": "3.24.0",
    "@tiptap/extension-document": "3.24.0",
    "@tiptap/extension-dropcursor": "3.24.0",
    "@tiptap/extension-gapcursor": "3.24.0",
    "@tiptap/extension-hard-break": "3.24.0",
    "@tiptap/extension-heading": "3.24.0",
    "@tiptap/extension-horizontal-rule": "3.24.0",
    "@tiptap/extension-italic": "3.24.0",
    "@tiptap/extension-link": "3.24.0",
    "@tiptap/extension-list": "3.24.0",
    "@tiptap/extension-list-item": "3.24.0",
    "@tiptap/extension-list-keymap": "3.24.0",
    "@tiptap/extension-ordered-list": "3.24.0",
    "@tiptap/extension-paragraph": "3.24.0",
    "@tiptap/extension-strike": "3.24.0",
    "@tiptap/extension-table": "3.27.1",
    "@tiptap/extension-table-cell": "3.27.1",
    "@tiptap/extension-table-header": "3.27.1",
    "@tiptap/extension-table-row": "3.27.1",
    "@tiptap/extension-text": "3.24.0",
    "@tiptap/extension-underline": "3.24.0",
    "@tiptap/extensions": "3.24.0",
    "@tiptap/html": "3.27.1",
    "@tiptap/pm": "3.24.0",
    "@tiptap/starter-kit": "3.27.1",
    "axios": "1.19.0",
    "body-parser": "2.3.0",
    "fast-uri": "3.1.6",
    "form-data": "4.0.6",
    "hono": "4.13.0",
    "@hono/node-server": "2.1.1",
    "ip-address": "10.4.0",
    "langsmith": "0.7.17",
    "postcss": "8.5.25",
    "browserslist": "4.28.9",
    "nanoid": "3.3.18",
    "protobufjs": "8.7.1",
    "qs": "6.16.0",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@eslint/js": "10.0.1",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/node": "26.1.2",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "fast-check": "4.8.0",
    "knip": "6.31.0",
    "prettier": "3.9.6",
    "typescript": "7.1.0-dev.20260809.1",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  },
  "packageManager": "npm@11.17.0"
}
