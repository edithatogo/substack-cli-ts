+export function buildReleaseScorecard(): ReleaseScorecard {
+  const gates: ReleaseScorecardGate[] = [
+    {
+      id: "local-quality",
+      title: "Local quality and packaging",
+      status: "ready",
+      localChecks: [
+        "npm run quality",
+        "npm test",
+        "node dist/cli.js inspect examples/basic.md",
+        "npm pack --dry-run --json",
+      ],
+      evidence: ["package.json", "package-lock.json", "dist/", "coverage/lcov.info"],
+      notes: ["Repo readiness is local and repeatable; it does not imply a package was published."],
+    },
+    {
+      id: "security-audit",
+      title: "Audit and secret scanning",
+      status: "advisory",
+      localChecks: ["npm run audit:prod", "npm run scan:secrets"],
+      evidence: ["scripts/secret-scan.mjs", "package-lock.json"],
+      notes: [
+        "CI keeps these checks visible in advisory lanes until false positives are consistently handled.",
+      ],
+    },
+    {
+      id: "sbom-provenance",
+      title: "SBOM and provenance readiness",
+      status: "advisory",
+      localChecks: ["npm run sbom:generate", "npm run provenance:check"],
+      evidence: ["reports/sbom/package-lock-sbom.json", ".github/workflows/publish.yml"],
+      ownerGate: "npm provenance evidence is produced by the tag-triggered publish workflow.",
+      notes: ["The local check verifies workflow intent; live provenance remains a release artifact."],
+    },
+    {
+      id: "external-launch",
+      title: "External launch and registry gates",
+      status: "owner-gated",
+      localChecks: [
+        "npm run registry:validate",
+        "npm run integrations:validate",
+        "node dist/cli.js coverage launch-check",
+      ],
+      evidence: [
+        "registry.server.json",
+        "docs/integrations/distribution-targets.md",
+        FRONTIER_LAUNCH_CHECKLIST_PATH,
+      ],
+      ownerGate:
+        "npm publish, GitHub Release creation, MCP registry submission, marketplace listings, and Substack admin changes require owner/admin action.",
+      notes: ["The CLI can validate readiness but must not perform account-gated launch actions."],
+    },
+    {
+      id: "branch-protection",
+      title: "Branch protection and dependency policy",
+      status: "owner-gated",
+      localChecks: ["Review docs/branch-protection.md"],
+      evidence: ["docs/branch-protection.md", ".github/dependabot.yml", ".github/renovate.json"],
+      ownerGate: "Repository rulesets must be configured by a maintainer in GitHub.",
+      notes: ["Required checks can be promoted only after advisory lanes are stable."],
+    },
+  ];
+
+  const summary = {
+    ready: gates.filter((gate) => gate.status === "ready").length,
+    ownerGated: gates.filter((gate) => gate.status === "owner-gated").length,
+    advisory: gates.filter((gate) => gate.status === "advisory").length,
+    blocked: gates.filter((gate) => gate.status === "blocked").length,
+  };
+
+  return {
+    operation: "release.scorecard",
+    status: summary.blocked === 0 ? "ready" : "blocked",
+    summary,
+    gates,
+  };
+}
+
+export function renderReleaseScorecard(scorecard: ReleaseScorecard = buildReleaseScorecard()): string {
+  const lines = [
+    "# Release and External Launch Scorecard",
+    "",
+    "This scorecard separates local repository readiness from advisory hardening lanes and owner/admin launch gates. It is a readiness report, not evidence that npm, GitHub Releases, registries, marketplaces, or Substack admin changes were performed.",
+    "",
+    "## Summary",
+    "",
+    `- Status: ${scorecard.status}`,
+    `- Ready gates: ${scorecard.summary.ready}`,
+    `- Advisory gates: ${scorecard.summary.advisory}`,
+    `- Owner/admin gated gates: ${scorecard.summary.ownerGated}`,
+    `- Blocked gates: ${scorecard.summary.blocked}`,
+    "",
+    "## Gates",
+    "",
+  ];
+
+  for (const gate of scorecard.gates) {
+    lines.push(
+      `### ${gate.title}`,
+      "",
+      `- ID: \`${gate.id}\``,
+      `- Status: \`${gate.status}\``,
+      "- Local checks:",
+      ...gate.localChecks.map((check) => `  - ${check}`),
+      "- Evidence:",
+      ...gate.evidence.map((evidence) => `  - ${evidence}`),
+    );
+
+    if (gate.ownerGate) {
+      lines.push(`- Owner/admin gate: ${gate.ownerGate}`);
+    }
+
+    lines.push("- Notes:", ...gate.notes.map((note) => `  - ${note}`), "");
+  }
+
+  return `${lines.join("\n").trimEnd()}\n`;
+}
+
 export function renderLaunchChecklist(
   items: LaunchChecklistItem[] = FRONTIER_LAUNCH_CHECKLIST,
 ): string {
