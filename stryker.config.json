{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "reporters": ["clear-text", "progress", "html"],
  "concurrency": 1,
  "mutate": [
    "src/parser/frontmatter.ts",
    "src/parser/schema.ts",
    "src/parser/markdown.ts",
    "src/parser/media.ts",
    "src/publish/title.ts",
    "src/publish/prepare.ts",
    "src/publish/prepublish.ts",
    "src/substack-api/payload.ts",
    "!src/**/*.test.ts",
    "!src/test/**"
  ],
  "coverageAnalysis": "perTest",
  "thresholds": {
    "high": 75,
    "low": 40,
    "break": 30
  }
}
