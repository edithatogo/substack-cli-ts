{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["src/benchmark/**/*.ts"],
  "project": ["src/**/*.ts"],
  "ignoreDependencies": ["prettier"],
  "ignoreBinaries": ["playwright"],
  "ignoreIssues": {
    "src/**/*.ts": ["exports", "types"]
  },
  "rules": {
    "exports": "off",
    "types": "off"
  }
}
