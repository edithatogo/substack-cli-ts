{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["src/mcp/server.ts", "src/benchmark/**/*.ts"],
  "project": ["src/**/*.ts"],
  "ignoreDependencies": ["prettier"],
  "ignoreBinaries": ["playwright"],
  "ignoreIssues": {
    "src/**/*.ts": ["exports", "types"]
  },
  "rules": {
    "binaries": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "files": "error",
    "types": "error"
  }
}
