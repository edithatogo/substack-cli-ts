{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["src/benchmark/**/*.ts"],
  "project": ["src/**/*.ts"],
  "ignoreDependencies": ["prettier", "substack-api"],
  "ignoreBinaries": ["biome", "playwright", "substack-cli"],
  "ignoreIssues": {
    "src/**/*.ts": ["exports", "types"]
  },
  "rules": {
    "exports": "off",
    "types": "off"
  }
}
