{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["src/mcp/server.ts", "src/benchmark/**/*.ts"],
  "project": ["src/**/*.ts"],
  "ignoreDependencies": ["prettier", "axios", "axios-rate-limit", "fp-ts", "io-ts"],
  "ignoreIssues": {
    "src/**/*.ts": ["exports", "types"]
  },
  "rules": {
    "binaries": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "files": "error",
    "types": "error"
  }
}
