  "html": "<h1>Table Support</h1>\n<p>Standard GFM table:</p>\n<table>\n<thead>\n<tr>\n<th>Header 1</th>\n<th>Header 2</th>\n<th>Header 3</th>\n</tr>\n</thead>\n<tbody><tr>\n<td>Row 1, Col 1</td>\n<td>Row 1, Col 2</td>\n<td>Row 1, Col 3</td>\n</tr>\n<tr>\n<td>Row 2, Col 1</td>\n<td>Row 2, Col 2</td>\n<td>Row 2, Col 3</td>\n</tr>\n</tbody></table>\n<p>Table with alignment:</p>\n<table>\n<thead>\n<tr>\n<th align=\"left\">Left</th>\n<th align=\"center\">Center</th>\n<th align=\"right\">Right</th>\n</tr>\n</thead>\n<tbody><tr>\n<td align=\"left\">Left-aligned</td>\n<td align=\"center\">Centered</td>\n<td align=\"right\">Right-aligned</td>\n</tr>\n<tr>\n<td align=\"left\">Cell</td>\n<td align=\"center\">Cell</td>\n<td align=\"right\">Cell</td>\n</tr>\n</tbody></table>\n<p>Table with inline formatting:</p>\n<table>\n<thead>\n<tr>\n<th>Feature</th>\n<th>Status</th>\n</tr>\n</thead>\n<tbody><tr>\n<td><strong>Bold</strong></td>\n<td>Supported</td>\n</tr>\n<tr>\n<td><em>Italic</em></td>\n<td>Supported</td>\n</tr>\n<tr>\n<td><code>Code</code></td>\n<td>Supported</td>\n</tr>\n<tr>\n<td><a href=\"https://example.com\">Link</a></td>\n<td>Supported</td>\n</tr>\n</tbody></table>\n",
