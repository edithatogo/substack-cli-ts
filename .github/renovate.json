{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":separateMajorMinor",
    ":combinePatchMinorUpdates",
    ":enableVulnerabilityAlerts",
    ":semanticCommits",
    "helpers:disableTypesNodeMajor",
    "npm:unpublishSafe",
    "group:monorepos",
    "group:recommended"
  ],
  "labels": ["dependencies", "renovate"],
  "schedule": ["before 9am on Monday"],
  "timezone": "UTC",
  "rangeStrategy": "bump",
  "dependencyDashboard": true,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["before 9am on Monday"]
  },
  "packageRules": [
    {
      "description": "Group all devDependencies updates",
      "matchDepTypes": ["devDependencies"],
      "groupName": "devDependencies",
      "automerge": true
    },
    {
      "description": "Group runtime dependencies",
      "matchDepTypes": ["dependencies"],
      "groupName": "runtime dependencies"
    },
    {
      "description": "Group Tiptap ecosystem updates",
      "matchPackagePrefixes": ["@tiptap/"],
      "groupName": "Tiptap",
      "automerge": true
    },
    {
      "description": "Group browser automation stack",
      "matchPackageNames": [
        "playwright-core",
        "@browserbasehq/stagehand",
        "camoufox-js"
      ],
      "groupName": "browser automation stack",
      "separateMajorMinor": true
    },
    {
      "description": "Group GitHub Actions updates",
      "matchDepTypes": ["action"],
      "groupName": "GitHub Actions",
      "automerge": true
    },
    {
      "description": "Pin critical tooling majors for manual review",
      "matchPackageNames": ["node", "typescript"],
      "enabled": false
    },
    {
      "description": "Ignore vendored substack-api package",
      "matchPackageNames": ["substack-api"],
      "enabled": false
    },
    {
      "description": "Major updates need manual review",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "renovate", "breaking"]
    }
  ],
  "vulnerabilityAlerts": {
    "labels": ["security", "renovate"],
    "automerge": true
  },
  "ignorePaths": ["vendor/**"],
  "rebaseWhen": "conflicted",
  "prCreation": "immediate",
  "prConcurrentLimit": 10,
  "platformAutomerge": true
}
